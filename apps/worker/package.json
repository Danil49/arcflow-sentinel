{
  "name": "@sentinel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "trace-once": "tsx --env-file-if-exists=../../.env scripts/trace-once.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "create-trace": "tsx --env-file-if-exists=../../.env scripts/create-trace.ts"
  },
  "dependencies": {
    "@sentinel/chains": "workspace:*",
    "@sentinel/config": "workspace:*",
    "@sentinel/contracts": "workspace:*",
    "@sentinel/core": "workspace:*",
    "@sentinel/db": "workspace:*",
    "@sentinel/evidence": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "testcontainers": "^11.14.0"
  }
}
