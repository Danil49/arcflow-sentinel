# Alchemy API key (enhanced APIs such as the Transfers API; https://dashboard.alchemy.com)
ALCHEMY_API_KEY=myKey

# Chain RPCs (Arc mainnet: https://docs.arc.io/arc/references/rpc-endpoints.md)
ARC_RPC_URL=https://rpc.mainnet.arc.io
BASE_RPC_URL=https://mainnet.base.org
# Used when CCTP_NETWORK=testnet
TESTNET_ARC_RPC_URL=https://rpc.testnet.arc.io
TESTNET_BASE_RPC_URL=https://sepolia.base.org
# Max eth_getLogs span your RPC tier allows (defaults: Arc 5000, Base 500; some free tiers: 10)
# ARC_LOG_CHUNK_SIZE=10
# BASE_LOG_CHUNK_SIZE=10
# Circle Iris attestation API (sandbox: https://iris-api-sandbox.circle.com)
IRIS_BASE_URL=https://iris-api.circle.com
# Network selection for CCTP addresses: mainnet | testnet
CCTP_NETWORK=mainnet

DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
# Worker: chains to tail passively (comma-separated: arc,base). Empty = trace-driven only.
# Tailing at a 10-block log span costs ~17k getLogs/day on Arc and ~4.3k/day on Base.
COLLECT=
# ARC_START_BLOCK=   # first block for a new collector stream (default: current head)
# BASE_START_BLOCK=
# WORKER_ID=

# Webhooks: comma-separated endpoints (https; http only for localhost). Every trace status
# change is POSTed to each, signed with HMAC-SHA256 over `${timestamp}.${body}`.
WEBHOOK_URLS=
# Required (>= 32 chars) when WEBHOOK_URLS is set. Generate: openssl rand -hex 32
WEBHOOK_SECRET=
# WEBHOOK_TIMEOUT_MS=10000

# Web API: comma-separated bearer keys (>= 24 chars) for privileged endpoints
# (POST /api/traces/{id}/confirm, POST /api/webhooks/test, requireAppConfirmation).
API_KEYS=

# Optional per-stage STUCK deadlines in minutes (defaults in packages/core/src/lifecycle.ts), e.g.
# STAGE_DEADLINES_JSON={"mint":180,"finality":{"standard":60}}

# Evidence signing: 32-byte Ed25519 seed (hex). Secret. Generate with
#   npx pnpm@10.18.3 --filter @sentinel/evidence keygen
# The public key is served at /.well-known/sentinel-key.json for verifiers.
EVIDENCE_SIGNING_KEY=

# Later phases
ANCHOR_PRIVATE_KEY=
