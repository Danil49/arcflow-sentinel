# Chain RPCs (Arc mainnet: https://docs.arc.io/arc/references/rpc-endpoints.md)
ARC_RPC_URL=https://rpc.mainnet.arc.io
BASE_RPC_URL=https://mainnet.base.org
# Used when CCTP_NETWORK=testnet
TESTNET_ARC_RPC_URL=https://rpc.testnet.arc.io
TESTNET_BASE_RPC_URL=https://sepolia.base.org
# Max eth_getLogs span your RPC tier allows (defaults: Arc 5000, Base 500; some free tiers: 10)
# ARC_LOG_CHUNK_SIZE=10
# BASE_LOG_CHUNK_SIZE=10
TESTNET_ARC_RPC_URL=https://rpc.testnet.arc.io
TESTNET_BASE_RPC_URL=https://sepolia.base.org
# Circle Iris attestation API (sandbox: https://iris-api-sandbox.circle.com)
IRIS_BASE_URL=https://iris-api.circle.com
# Network selection for CCTP addresses: mainnet | testnet
CCTP_NETWORK=mainnet

DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
# Worker: chains to tail passively (comma-separated: arc,base). Empty = trace-driven only.
# Tailing at a 10-block log span costs ~17k getLogs/day on Arc and ~4.3k/day on Base.
COLLECT=
# ARC_START_BLOCK=   # first block for a new collector stream (default: current head)
# BASE_START_BLOCK=
# WORKER_ID=

# Later phases
EVIDENCE_SIGNING_KEY=
ANCHOR_PRIVATE_KEY=
WEBHOOK_SECRET=
